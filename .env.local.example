# ============================================================
#  Choix du backend — c'est la seule ligne qui bascule le mode
# ============================================================
#   sqlite   : tout tourne sur ce PC. Aucun compte, aucun internet.
#   supabase : base dans le cloud. Pour un déploiement Vercel.
#
# Si tu laisses la ligne vide, le mode est déduit : Supabase si les clés
# ci-dessous sont remplies, SQLite sinon.
NEXT_PUBLIC_DATA_BACKEND=sqlite

# Code d'accès à /admin. Requis dans les deux modes.
# Choisis-en un long, il protège la clôture des manches.
ADMIN_CODE=change-moi-avant-le-jour-J


# ------------------------------------------------------------
#  Mode SQLite — rien à configurer
# ------------------------------------------------------------
# Le fichier est créé tout seul au premier lancement, avec 20 équipes
# à renommer depuis /admin. Décommente pour le ranger ailleurs.
# SQLITE_PATH=.data/votes.db


# ------------------------------------------------------------
#  Mode Supabase — Project Settings > API
# ------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé service_role : NE JAMAIS la préfixer NEXT_PUBLIC_, elle contourne les RLS.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
